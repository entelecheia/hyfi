# Read by ${oc.env:...} in hyfi's default project config. .env never overrides variables already set.
HYFI_PROJECT_NAME=
HYFI_PROJECT_ROOT=
HYFI_PROJECT_WORKSPACE=
# Comma-separated execution allowlist for `hyfi run` / `hyfi rerun`, e.g. mypkg.*,builtins.len
HYFI_ALLOW=
# Python logging level for the CLI (default WARNING)
HYFI_LOG_LEVEL=
